# Multi Brain is local agent memory only — never commit (may hold paths / notes).
.multibrain/

# Keep the folder, ignore the private design notes inside it.
# Public documentation (install guide, contributing, screenshots) is tracked deliberately.
/docs/*
!/docs/README.md
!/docs/INSTALL.md
!/docs/images/

