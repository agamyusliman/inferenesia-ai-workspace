# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# --- Editors / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.history/

# --- Env & secrets (NEVER commit credentials) ---
# Real env files (keep examples trackable)
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.*.local
.envrc
.direnv/
.env.production
.env.development
.env.staging
.env.test

# Credential / key material (filename globs — not Go source packages)
# Note: broad *secret* globs; re-include the secrethyg package + git secrets
# guard source so agents can commit redaction code (not credential material).
*secret*
*secrets*
!docs/**/*secret*
!docs/**/*secrets*
!internal/secrethyg/
!internal/secrethyg/**
# Re-include the git package staged-secret guard source files
# (internal/git/secrets.go / secrets_test.go implement the pre-commit guard
# that REFUSES secrets at commit time — they are source, not credential material).
!internal/git/secrets.go
!internal/git/secrets_test.go
*credential*
*credentials*
!*credential*.md
!*credentials*.md
*.pem
*.key
!*.key.md
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
*.ppk
*.kdbx
auth.json
token.json
tokens.json
*.token
*.tokens
service-account*.json
*-service-account.json
google-credentials.json
firebase-adminsdk*.json
.aws/
.azure/
.gcloud/
.kube/config
.docker/config.json
.netrc
.npmrc
.pypirc
.npm/_auth
.yarnrc.yml
.pnpmfile.cjs
# Common raw key filename patterns
*_api_key*
*_apikey*
*.api_key
*.apikey

# Local app config that often holds API keys
config.local.*
**/config/local.*
**/config/*secrets*
**/config/*credentials*
*.local.json
*.local.yaml
*.local.yml
*.local.toml
providers.local.*
settings.local.*
secrets.yaml
secrets.yml
secrets.toml
secrets.json
credentials.yaml
credentials.yml
credentials.toml
credentials.json
api-keys.*
apikeys.*
api_keys.*
.byok/
.byok/*
keys/
!docs/**/keys/**
# Runtime config under home should never be committed from a workspace copy
.yura-ai/
**/.yura-ai/config.yaml

