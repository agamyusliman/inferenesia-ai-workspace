# Copy to .env and fill in locally. Never commit .env.
# The app also reads these from your shell; a real environment variable wins
# over anything set here.

# --- Settings location ---
# Optional. Default is ~/.inferenesia
# INFERENESIA_HOME=

# --- Model endpoint (OpenAI-compatible) ---
# Point this at any service that speaks the OpenAI API, then set a key.
INFERENESIA_BASE_URL=
INFERENESIA_API_KEY=

# Optional default model. Leave unset and the app lists them from GET /v1/models.
# INFERENESIA_MODEL=

# --- BYOK provider keys ---
# Individual providers can be declared in ~/.inferenesia/config.yaml and
# referenced by environment variable name, so the secret never lives in a file:
#
#   profiles:
#     my-provider:
#       type: openai_compatible
#       base_url: https://api.example.com/v1
#       api_key_env: MY_PROVIDER_API_KEY
#
# MY_PROVIDER_API_KEY=

# --- Legacy variable names ---
# Older names are still read, for configuration written before the rename.
# Prefer the INFERENESIA_* names above.
# YURA_AI_HOME=
# TEMP_AI_BASE_URL=
# TEMP_AI_API_KEY=
# TEMP_AI_MODEL=
